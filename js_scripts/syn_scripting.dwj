// ------------------------
// Devices extraction
// ------------------------

_devices = get_devices();

function get_devices(){

    device = defaultObject();
    sub = device.subCircuit;
    devices = sub.devices;

    machine = null;
    lf = null;

    for (i = 0; i < devices.length; i++) {

        dev = devices[i];
        libtype = dev.getAttribute("LibType");

        if (libtype == "Synchronous") {
            machine = dev;
        }

        if (libtype == "Load-Flow Bus") {
            lf = dev;
        }
    }

    return _devices = {
        machine: machine,
        lf: lf
    };
}

// ------------------------
// Devices extraction
// ------------------------

_devices = get_devices();

function get_devices(){

    device = defaultObject();
    sub = device.subCircuit;
    devices = sub.devices;

    machine = null;
    lf = null;

    for (i = 0; i < devices.length; i++) {

        dev = devices[i];
        libtype = dev.getAttribute("LibType");

        if (libtype == "Synchronous") {
            machine = dev;
        }

        if (libtype == "Load-Flow Bus") {
            lf = dev;
        }
    }

    return _devices = {
        machine: machine,
        lf: lf
    };
}

// ------------------------
// Get model and devices
// ------------------------
device = defaultObject();
devices = device.subCircuit.devices;

machine = _devices.machine;
lf = _devices.lf;

// ------------------------
// Parse data
// ------------------------
parseScriptFile('machine_sm_m.dwj');
machine_data = new oDevice_SM(machine);

parseScriptFile('load_flow_bus_m.dwj');
lf_data = new oDevice_Load_flow_bus(lf);

// ------------------------
// Machine data
// ------------------------
s_nominal = Number(machine_data.Rating_S);
vk_nominal = Number(machine_data.Rating_V);

// ------------------------
// Set in service
// ------------------------
for (i = 0; i < devices.length; i++) {

    internal_device = devices[i];

    if (in_service == 0) {
        internal_device.setAttribute('Exclude', 'Ex');
    } else {
        internal_device.setAttribute('Exclude', '');
    }
}

// ------------------------
// Active Power set
// ------------------------
p_set = Number(p_dispatch);

if (p_set < 0) {
    p_set = 0;
}

if (p_set > s_nominal) {
    p_set = s_nominal;
}

lf_data.P_set = String(p_set);

// ------------------------
// Bus type and Q / V set
// ------------------------
if (bus_type == 1) {

    q_min = Number(lf_data.Q_min);
    q_max = Number(lf_data.Q_max);
    q_set = Number(q_dispatch);

    if (q_set < q_min) {
        q_set = q_min;
    }

    if (q_set > q_max) {
        q_set = q_max;
    }

    lf_data.Bus_Type = 'PQ';
    lf_data.Q_set = String(q_set);

} else if (bus_type == 2) {

    v_set = Number(v_setpoint) * vk_nominal;

    lf_data.Bus_Type = 'PV';
    lf_data.Voltage_Slack = String(v_set);

} else if (bus_type == 3) {

    v_set = Number(v_setpoint) * vk_nominal;

    lf_data.Bus_Type = 'Slack';
    lf_data.Voltage_Slack = String(v_set);

} else {

    q_min = Number(lf_data.Q_min);
    q_max = Number(lf_data.Q_max);
    q_set = Number(q_dispatch);

    if (q_set < q_min) {
        q_set = q_min;
    }

    if (q_set > q_max) {
        q_set = q_max;
    }

    lf_data.Bus_Type = 'PQ';
    lf_data.Q_set = String(q_set);
}
lf_data.SaveData();

// ------------------------
// Assign LF to machine and Saving
// ------------------------
lf_part = String(lf.getAttribute("Part"));
lf_name = String(lf.getAttribute("Name"));
lf_device_name = lf_part + ":" + lf_name;
machine_data.LFdevName = String(lf_device_name);

machine_part = String(machine.getAttribute("Part"));
machine_name = String(machine.getAttribute("Name"));
retrieve_lf_data = machine_part + ":" + machine_name;
lf_data.TalkdevName = String(retrieve_lf_data);

machine_data.SaveData();
lf_data.SaveData();