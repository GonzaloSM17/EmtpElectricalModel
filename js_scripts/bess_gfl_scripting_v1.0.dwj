// ------------------------
// Model extraction
// ------------------------

_model_ = get_model();

function get_model(){

device = defaultObject();
sub = device.subCircuit
devices = sub.devices

for (i = 0; i < devices.length; i++) {

    dev = devices[i];
    libtype = dev.getAttribute("LibType");

    if (libtype == "AC-DC converter with control") {
        unit = dev;
    }
}

return _model_=unit
}

// ------------------------
// Get model
// ------------------------
device = defaultObject();
all_devices = device.subCircuit.devices
model = _model_;

// ------------------------
// Parse methods
// ------------------------
parseScriptFile('Toolboxes/PowerElectronics/Scripts/Inverter3P_m.dwj');
load_data = new oDevice_Inverter(model);

// ------------------------
// Set in service
// ------------------------
for (i = 0; i < all_devices.length; i++) {

    internal_device = devices[i];

    if (in_service == 0) {
        internal_device.setAttribute('Exclude', 'Ex');
    } else {
        internal_device.setAttribute('Exclude', '');
    }
}

// ------------------------
// Power base
// ------------------------
n_gen = Number(load_data.Parameters.Ngen);
s_single = Number(load_data.Parameters.Sgen);
s_total = n_gen * s_single;

// ------------------------
// Active power
// ------------------------
load_data.Parameters.Ngen_in_service = n_gen;

p_setpoint_pu = p_setpoint / s_total;

if (p_setpoint_pu > 1) {
    p_setpoint_pu = 1;
}

if (p_setpoint_pu < -1) {
    p_setpoint_pu = -1;
}

load_data.Parameters.Pref_pu = p_setpoint_pu;


// ------------------------
// Reactive power
// ------------------------
q_setpoint_pu = q_setpoint / s_total;

if (q_setpoint_pu > 0.33) {
    q_setpoint_pu = 0.33;
}

if (q_setpoint_pu < -0.33) {
    q_setpoint_pu = -0.33;
}

load_data.Parameters.Qref_pu = q_setpoint_pu;


// ------------------------
// Saving
// ------------------------
load_data.SaveData();