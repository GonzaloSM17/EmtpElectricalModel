// ------------------------
// Model extraction
// ------------------------

_model = get_model();

function get_model(){

device = defaultObject();
sub = device.subCircuit
devices = sub.devices

return _model=devices[0]
}

// ------------------------
// Get model
// ------------------------
device = defaultObject();
model = _model;

model.setAttribute('Name', device.name);

// ------------------------
// Parse methods
// ------------------------
parseScriptFile('WECC_WP_m.dwj');
load_data = new oDevice_WECC_WP(model);

// ------------------------
// Set in service
// ------------------------
if (in_service == 0) {
    model.setAttribute('Exclude', 'Ex');
} else {
    model.setAttribute('Exclude', '');
}

// ------------------------
// Power base
// ------------------------
n_gen = Number(load_data.Parameters.Ngen);
s_single = Number(load_data.Parameters.Sgen);
s_total = n_gen * s_single;

// ------------------------
// Active power
// ------------------------
load_data.Parameters.Ngen_in_service = n_gen;

P_setpoint_pu = p_setpoint / s_total;

if (P_setpoint_pu > 1) {
    P_setpoint_pu = 1;
}

load_data.Parameters.Pref_poi = P_setpoint_pu;

// ------------------------
// Reactive power control
// ------------------------
q_setpoint_pu = q_setpoint / s_total;

if (q_setpoint_pu > 0.33) {
    q_setpoint_pu = 0.33;
}

load_data.Parameters.QC_select = 1;
load_data.Parameters.Qpoi_pu = q_setpoint_pu;

// ------------------------
// Saving
// ------------------------